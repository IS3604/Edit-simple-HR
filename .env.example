# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only — NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — email notifications via Resend (https://resend.com). Leave empty to disable.
RESEND_API_KEY=
EMAIL_FROM="EditSimple HR <hr@editsimple.in>"
# Public URL used for links in emails, e.g. https://editsimple-hr.vercel.app
APP_URL=

# Optional — web push notifications. Generate once with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hr@editsimple.in

# Ask AI (Superadmin assistant) — server only. Model is optional.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
